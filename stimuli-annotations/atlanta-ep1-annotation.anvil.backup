      <el index="186" start="526.44" end="533.12">
        <attribute name="narrative details - internal">Earn's parents are not particularly proud of him.</attribute>
        <attribute name="narrative details - external">Earn's mother scolds him and tells him to eat better food, not the junk she found in the toilet.</attribute>
        <attribute name="characters on screen">Mom</attribute>
      </el>
      <el index="187" start="533.12" end="534.40002">
        <attribute name="narrative details - internal">Earn is being sarcastic</attribute>
        <attribute name="narrative details - external">Earn asks if his mother knew what he was eating because she investigated the contents of the toilet.</attribute>
        <attribute name="characters on screen">Earn</attribute>
