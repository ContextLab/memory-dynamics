<annotation>
  <head>
    <specification src="annotation-scheme.xml" />
    <video src="../../video-stims/atlanta-ep1.mp4" master="true" />
    <info key="coder" type="String">paxtonfitzpatrick</info>
    <info key="encoding" type="String">UTF8</info>
  </head>
  <body>
    <track name="Scene info" type="primary">
      <el index="0" start="0" end="1.96">
        <attribute name="narrative details - internal">Alfred Paper Boy is surprised and angry.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy is sitting in his car when a foot kicks off his side view mirror. Alfred Paper Boy turns and exclaims</attribute>
        <attribute name="characters on screen">Alfred Paper Boy</attribute>
      </el>
      <el index="1" start="1.96" end="5">
        <attribute name="narrative details - internal">Alfred Paper Boy is surprised and angry.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy and Darius open the doors and get out of the car. A man and woman walk away from the car. Alfred Paper Boy yells after them.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Darius, Man, Woman</attribute>
      </el>
      <el index="2" start="5" end="5.72">
        <attribute name="narrative details - internal">Alfred Paper Boy is angry. Earn is concerned.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy steps out of the car. Earn yells his name.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy</attribute>
      </el>
      <el index="3" start="5.72" end="7.8">
        <attribute name="narrative details - internal">Alfred Paper Boy is angry.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy slams the car door and yells after the man and woman, asking for money for his broken mirror.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn</attribute>
      </el>
      <el index="4" start="7.8" end="8.2">
        <attribute name="narrative details - internal">Earn is worried.</attribute>
        <attribute name="narrative details - external">Earn, sitting in the car, calls after Alfred again.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="5" start="8.2" end="9.88">
        <attribute name="narrative details - internal">Alfred Paper Boy is angry</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy walks after the man and woman and confronts them</attribute>
        <attribute name="characters on screen">Alfred Paper Boy</attribute>
      </el>
      <el index="6" start="9.88" end="11">
        <attribute name="narrative details - external">Alfred Paper Boy calls out after the man and woman. Earn gets out of the car and runs after him.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="7" start="11" end="11.84">
        <attribute name="narrative details - internal">Alfred Paper Boy is angry. Earn is trying to calm him down.</attribute>
        <attribute name="narrative details - external">Earn runs after Alfred Paper Boy and tries to get his attention. Alfred Paper Boy yells at the man and woman.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="8" start="11.84" end="13.24">
        <attribute name="narrative details - internal">Alfred Paper Boy is angry.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy, Earn, and Darius catch up to the man and woman. Alfred Paper Boy shouts at the man and woman.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Darius, Man, Woman</attribute>
      </el>
      <el index="9" start="13.24" end="15.8">
        <attribute name="narrative details - internal">Earn is trying to calm everyone down and diffuse the situation.</attribute>
        <attribute name="narrative details - external">Earn touches Alfred Paper Boy's chest and asks everyone to stay relaxed.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Darius, Man, Woman</attribute>
      </el>
      <el index="10" start="15.8" end="17.32">
        <attribute name="narrative details - internal">The situation is escalating.</attribute>
        <attribute name="narrative details - external">The man threatens Alfred Paper Boy.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Darius, Man, Woman</attribute>
      </el>
      <el index="11" start="17.32" end="18.24">
        <attribute name="narrative details - external">A voice in the background shouts.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Darius, Man, Woman</attribute>
      </el>
      <el index="12" start="18.24" end="19.36">
        <attribute name="narrative details - internal">Earn is trying to diffuse the situation.</attribute>
        <attribute name="narrative details - external">Earn tells the person who shouted to stop.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Man</attribute>
      </el>
      <el index="13" start="19.36" end="23.2">
        <attribute name="narrative details - external">Alfred Paper Boy asks again for money for the broken mirror.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Man</attribute>
      </el>
      <el index="14" start="23.2" end="24.52">
        <attribute name="narrative details - external">The man refuses to give Alfred Paper Boy Money.</attribute>
        <attribute name="characters on screen">Man, Woman</attribute>
      </el>
      <el index="15" start="24.52" end="25.72">
        <attribute name="narrative details - internal">Earn tries to diffuse the situation.</attribute>
        <attribute name="narrative details - external">Earn tries to reason with the man.</attribute>
        <attribute name="characters on screen">Man, Woman</attribute>
      </el>
      <el index="16" start="25.72" end="32.24">
        <attribute name="narrative details - internal">Earn tries to diffuse the situation.</attribute>
        <attribute name="narrative details - external">Earn tries to reason with the man, pointing out that all of them are poor and nobody wants any trouble. Alfred Paper Boy looks at him.</attribute>
        <attribute name="characters on screen">Earn, Alfred Paper Boy, Man</attribute>
      </el>
      <el index="17" start="32.24" end="33.64">
        <attribute name="narrative details - internal">The woman antagonizes Alfred Paper Boy and mocks Earn.</attribute>
        <attribute name="narrative details - external">The woman speaks up.</attribute>
        <attribute name="characters on screen">Woman, Man</attribute>
      </el>
      <el index="18" start="33.64" end="35">
        <attribute name="narrative details - internal">Alfred Paper Boy is rude and angry. Tensions rise.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy tells the woman to shut up.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Man</attribute>
      </el>
      <el index="19" start="35" end="35.76">
        <attribute name="narrative details - internal">The woman is offended. Tensions rise.</attribute>
        <attribute name="narrative details - external">The woman yells at Alfred Paper Boy not to talk that way to her.</attribute>
        <attribute name="characters on screen">Woman, Man</attribute>
      </el>
      <el index="20" start="35.76" end="40.44">
        <attribute name="narrative details - internal">The man is angry. Tensions rise.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy defends himself and offers to settle any other problems, but demands money for his broken car mirror. The man yells at him.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Woman</attribute>
      </el>
      <el index="21" start="40.44" end="41.84">
        <attribute name="narrative details - external">Darius interjects.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Man</attribute>
      </el>
      <el index="22" start="41.84" end="46.48">
        <attribute name="narrative details - external">Darius says he is having déja vu and looks around for a dog with spots that look like Texas. Alfred Paper Boy and Earn turn and look at him.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Darius</attribute>
      </el>
      <el index="23" start="46.48" end="49.32">
        <attribute name="narrative details - internal">Darius is experiencing déja vu.</attribute>
        <attribute name="narrative details - external">Darius looks around, finds the dog, and points him out.</attribute>
        <attribute name="characters on screen">Darius, Alfred Paper Boy, Earn</attribute>
      </el>
      <el index="24" start="49.32" end="51.16">
        <attribute name="narrative details - internal">Darius is surprised and confused.</attribute>
        <attribute name="narrative details - external">Across the street, a dog sits in the grass. Darius comments.</attribute>
        <attribute name="characters on screen">Dog</attribute>
      </el>
      <el index="25" start="51.16" end="52.8">
        <attribute name="narrative details - internal">Alfred Paper Boy and Earn are confused.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy and Earn look across the street at the dog. Earn looks at the man and woman.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn</attribute>
      </el>
      <el index="26" start="52.8" end="54.52">
        <attribute name="narrative details - internal">The man is confused.</attribute>
        <attribute name="narrative details - external">The man and woman look across the street at the dog. The man asks what is wrong with Darius.</attribute>
        <attribute name="characters on screen">Man, Woman</attribute>
      </el>
      <el index="27" start="54.52" end="55.52">
        <attribute name="narrative details - internal">Alfred Paper Boy is frustrated and angry.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy holds up the broken mirror and changes the subject back to it.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Man</attribute>
      </el>
      <el index="28" start="55.52" end="57.88">
        <attribute name="narrative details - internal">The man and woman are angry.</attribute>
        <attribute name="narrative details - external">The woman recognizes Alfred Paper Boy and tells him to buy another mirror. The man glares.</attribute>
        <attribute name="characters on screen">Woman, Man</attribute>
      </el>
      <el index="29" start="57.88" end="58.8">
        <attribute name="narrative details - internal">Earn is worried about Alfred Paper Boy being recognized.</attribute>
        <attribute name="narrative details - external">The woman says Alfred Paper Boy has money. Earn looks at Alfred Paper Boy</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="30" start="58.8" end="60.12">
        <attribute name="narrative details - internal">Earn is concerned about Alfred Paper Boy being recognized.</attribute>
        <attribute name="narrative details - external">The man exclaims. Earn looks at Alfred Paper Boy silently.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="31" start="60.12" end="63.16">
        <attribute name="narrative details - internal">The man is mockingly surprised.</attribute>
        <attribute name="narrative details - external">The man asks if Alfred Paper Boy is Paper Boy.</attribute>
        <attribute name="characters on screen">Man, Woman</attribute>
      </el>
      <el index="32" start="63.16" end="63.88">
        <attribute name="narrative details - external">Alfred Paper Boy confirms that he is Paper Boy.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Man, Earn</attribute>
      </el>
      <el index="33" start="63.88" end="65.76">
        <attribute name="narrative details - external">The man insults Alfred Paper Boy.</attribute>
        <attribute name="characters on screen">Man, Woman</attribute>
      </el>
      <el index="34" start="65.76" end="67.72">
        <attribute name="narrative details - internal">Earn is worried about the situation escalating</attribute>
        <attribute name="narrative details - external">The man continues to insult Alfred Paper Boy and his music. Earn looks at Alfred Paper Boy.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="35" start="67.72" end="71.76">
        <attribute name="narrative details - external">The man insults and mocks Alfred Paper Boy and talks about one of his songs.</attribute>
        <attribute name="characters on screen">Man, Woman</attribute>
      </el>
      <el index="36" start="71.76" end="73.76">
        <attribute name="narrative details - internal">Alfred Paper Boy gets angry</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy defends his music</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn</attribute>
      </el>
      <el index="37" start="73.76" end="76.84">
        <attribute name="narrative details - external">Alfred Paper Boy pulls out a gun and points it at the man's chest.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn Darius, Man, Woman</attribute>
      </el>
      <el index="38" start="76.84" end="78.36">
        <attribute name="narrative details - internal">The man is angry at Alfred Paper Boy.</attribute>
        <attribute name="narrative details - external">The man glares at Alfred Paper Boy. Someone in the background shouts again.</attribute>
        <attribute name="characters on screen">Man, Woman, Alfred Paper Boy</attribute>
      </el>
      <el index="39" start="78.36" end="81.68">
        <attribute name="narrative details - internal">Earn gets worried and stops trying to calm them down.</attribute>
        <attribute name="narrative details - external">Alfred again tells the person who yelled to stop. He asks Alfred Paper Boy what he is doing, then pulls out and cocks a gun.</attribute>
        <attribute name="characters on screen">Earn, Alfred Paper Boy</attribute>
      </el>
      <el index="40" start="81.68" end="83">
        <attribute name="narrative details - internal">Alfred Paper Boy is surprised Earn has a gun.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy asks Earn what he is doing.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Man</attribute>
      </el>
      <el index="41" start="83" end="84.76">
        <attribute name="narrative details - internal">The situation escalates.</attribute>
        <attribute name="narrative details - external">The man pulls p his shirt to reveal a gun in his belt.</attribute>
        <attribute name="characters on screen">Man</attribute>
      </el>
      <el index="42" start="84.76" end="86.04">
        <attribute name="narrative details - internal">Earn is worried about tensions escalating the situation to violence. He knows there is about to be trouble.</attribute>
        <attribute name="narrative details - external">Earn looks from Alfred Paper Boy to the man's gun.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="43" start="86.04" end="89.68">
        <attribute name="narrative details - internal">The situation escalates. The man taunts Alfred Paper Boy.</attribute>
        <attribute name="narrative details - external">The man points out friends nearby, pushes the woman back, and turns to Alfred Paper Boy</attribute>
        <attribute name="characters on screen">Man, Woman, Alfred Paper Boy</attribute>
      </el>
      <el index="44" start="89.68" end="91.8">
        <attribute name="narrative details - internal">The situation escalates. The man taunts Alfred Paper Boy.</attribute>
        <attribute name="narrative details - external">The man yells at Alfred Paper Boy and asks him what is up again.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Man</attribute>
      </el>
      <el index="45" start="91.8" end="94.28">
        <attribute name="narrative details - internal">Earn knows there is about to be trouble.</attribute>
        <attribute name="narrative details - external">Alfred Paper Boy cocks the gun and points it at the man's chest. Earn looks at him.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Man</attribute>
      </el>
      <el index="46" start="94.28" end="95.56">
        <attribute name="narrative details - internal">The man and Alfred Paper Boy are trying to intimidate each other.</attribute>
        <attribute name="narrative details - external">The man stares at Alfred Paper Boy.</attribute>
        <attribute name="characters on screen">Man, Woman, Alfred Paper Boy</attribute>
      </el>
      <el index="47" start="95.56" end="97.12">
        <attribute name="narrative details - internal">Earn is surprised to see the dog.</attribute>
        <attribute name="narrative details - external">Earn looks over and sees the dog across the street.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="48" start="97.12" end="98.48">
        <attribute name="narrative details - external">The dog is still sitting in the grass across the street.</attribute>
        <attribute name="characters on screen">Dog</attribute>
      </el>
      <el index="49" start="98.48" end="99.52">
        <attribute name="narrative details - internal">Earn is surprised and confused to see the dog. He gets déja vu as well.</attribute>
        <attribute name="narrative details - external">Earn stares at the dog across the street.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="50" start="99.52" end="102.36">
        <attribute name="narrative details - internal">Darius is confused and experiencing déja vu.</attribute>
        <attribute name="narrative details - external">Darius looks at the dog across the street.</attribute>
        <attribute name="characters on screen">Darius, Alfred Paper Boy, Earn</attribute>
      </el>
      <el index="51" start="102.36" end="105.08">
        <attribute name="narrative details - external">A view from above of Alfred Paper Boy firing his gun. The screen goes black</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Earn, Darius, Man, Woman</attribute>
      </el>
      <el index="52" start="105.08" end="107.36">
        <attribute name="narrative details - external">BLACK SCREEN 1</attribute>
      </el>
      <el index="53" start="107.36" end="116.08">
        <attribute name="narrative details - external">Music fades in. Aerial view of houses, parks, and streets of Atlanta</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="54" start="116.08" end="118.88">
        <attribute name="narrative details - external">Aerial view of a cul de sac and surrounding houses</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="55" start="118.88" end="124.44">
        <attribute name="narrative details - external">Aerial view of a road and the wreckage of an abandoned house</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="56" start="124.44" end="128.16">
        <attribute name="narrative details - external">Aerial view of a busy highway.</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="57" start="128.16" end="130.88">
        <attribute name="narrative details - external">Aerial view of a park and eating area with umbrellas.</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="58" start="130.88" end="134.67999">
        <attribute name="narrative details - external">Aerial view of a basketball court with some people playing on it.</attribute>
        <attribute name="characters on screen">basketball players</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="59" start="134.67999" end="141.16">
        <attribute name="narrative details - external">Aerial view of a road and surrounding woods with the city of Atlanta in the background. "ATLANTA" appears in white block letters.</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="60" start="141.16" end="143.92">
        <attribute name="narrative details - external">A ceiling fan in Earn's bedroom rotates slowly. Music plays in the background.</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="61" start="143.92" end="147">
        <attribute name="narrative details - external">Earn lays in his bed listening to music with headphones on</attribute>
        <attribute name="characters on screen">Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="62" start="147" end="149.39999">
        <attribute name="narrative details - external">Suddenly, Van's arm hits Earn on the head while he is laying in bed listening to music.</attribute>
        <attribute name="characters on screen">Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="63" start="149.39999" end="152.96001">
        <attribute name="narrative details - internal">Van is annoyed with Earn's music</attribute>
        <attribute name="narrative details - external">Van, laying next to Earn, reaches over and pulls his headphones off.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="64" start="152.96001" end="156.64">
        <attribute name="narrative details - internal">Van is tired and annoyed with Earn's music</attribute>
        <attribute name="narrative details - external">Van, laying next to Earn, reaches over and pulls his headphones off.  She asks him why he is awake so early.</attribute>
        <attribute name="characters on screen">Van, Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="65" start="156.64" end="160.96001">
        <attribute name="narrative details - external">Earn pulls his headphones off and says he had a strange dream.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
      </el>
      <el index="66" start="160.96001" end="169.60001">
        <attribute name="narrative details - internal">The dream is symbolic of Earn's dangerous immersion in street culture.</attribute>
        <attribute name="narrative details - external">Earn describes his dream of swimming in a pool like an ocean with seaweed like hands. Earn wiggles his fingers.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="67" start="169.60001" end="178.39999">
        <attribute name="narrative details - internal">The dream is symbolic of Earn's dangerous immersion in street culture.</attribute>
        <attribute name="narrative details - external">Earn wiggles his fingers and describes a girl in his dream who told him to swim above the hands and avoid them or he would drown.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="68" start="178.39999" end="180.75999">
        <attribute name="narrative details - internal">Van sarcastically responds to Earn's description of his dream</attribute>
        <attribute name="narrative details - external">Van responds to Earn's dream.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="69" start="180.75999" end="182.39999">
        <attribute name="narrative details - external">Earn starts to interpret his dream as having a meaning about society.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="70" start="182.39999" end="183.08">
        <attribute name="narrative details - external">Earn talks about his dream.</attribute>
        <attribute name="characters on screen">Van, Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="71" start="183.08" end="184">
        <attribute name="narrative details - internal">Van does not like that Earn dreamt about a girl and is more interested in the girl than the dream.</attribute>
        <attribute name="narrative details - external">Van cuts Earn off and asks about the girl in his dream.</attribute>
        <attribute name="characters on screen">Van, Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="72" start="184" end="186.52">
        <attribute name="narrative details - external">Earn pauses and says he does not know who the girl in his dream was.</attribute>
        <attribute name="characters on screen">Van, Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="73" start="186.52" end="187.75999">
        <attribute name="narrative details - internal">Van is being possessive and is more interested in the girl than Earn's dream.</attribute>
        <attribute name="narrative details - external">Van asks what the girl from Earn's dream looked like.</attribute>
        <attribute name="characters on screen">Van, Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="74" start="187.75999" end="192.32001">
        <attribute name="narrative details - internal">Earn realizes Van is jealous that he dreamt about a girl and tries to make her sound unappealing.</attribute>
        <attribute name="narrative details - external">Earn downplays the girl in his dream.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="75" start="192.32001" end="193.92">
        <attribute name="narrative details - internal">Van does not believe Earn.</attribute>
        <attribute name="narrative details - external">Van rolls her eyes and responds.</attribute>
        <attribute name="characters on screen">Van, Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="76" start="193.92" end="195.52">
        <attribute name="narrative details - external">Earn asks if Van is jealous of the girl in his dream.</attribute>
        <attribute name="characters on screen">Van, Earn</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="77" start="195.52" end="205.08">
        <attribute name="narrative details - internal">Van is jealous</attribute>
        <attribute name="narrative details - external">Van chides Earn about the dream girl and accuses him of making out with her in the dream.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="78" start="205.08" end="206.92">
        <attribute name="narrative details - external">Earn says he never mentioned making out with the dream girl.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="79" start="206.92" end="208.03999">
        <attribute name="narrative details - internal">Van is jealous of the dream girl.</attribute>
        <attribute name="narrative details - external">Van directly asks Earn if he and the dream girl made out.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="80" start="208.03999" end="209.32001">
        <attribute name="narrative details - external">Earn admits he and the dream girl were making out.</attribute>
        <attribute name="characters on screen">Earn, Van</attribute>
        <attribute name="Music Presence">true</attribute>
