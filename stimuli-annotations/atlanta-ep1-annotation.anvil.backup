        <attribute name="characters on screen">Alfred Paper Boy, Darius</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="406" start="1221.80005" end="1226.31995">
        <attribute name="narrative details - internal">Earn knows he is responsible for the song playing on the radio and is pleased with himself</attribute>
        <attribute name="narrative details - external">Earn smiles, laughs, looks around, and remarks how quickly Alfred Paper Boy's song made it on the radio</attribute>
        <attribute name="characters on screen">Earn, Lottie</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="407" start="1226.31995" end="1228.43994">
