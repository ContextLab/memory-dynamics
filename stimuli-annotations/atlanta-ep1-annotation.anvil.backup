        <attribute name="characters on screen">Alfred Paper Boy</attribute>
      </el>
      <el index="195" start="562.64001" end="567.15997">
        <attribute name="narrative details - external">Darius, Alfred Paper Boy's friend, looks through the fridge for something.</attribute>
        <attribute name="characters on screen">Darius</attribute>
      </el>
      <el index="196" start="567.15997" end="573.35999">
        <attribute name="narrative details - external">Darius, wearing an apron and carrying a carton of milk, walks up behind Alfred Paper Boy and asks if the milk is still good</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Darius</attribute>
      </el>
      <el index="197" start="573.35999" end="574.76001">
        <attribute name="narrative details - external">Without looking up from his video game, Alfred Paper Boy asks what Darius wants to use the milk for.</attribute>
        <attribute name="characters on screen">Alfred Paper Boy, Darius</attribute>
      </el>
      <el index="198" start="574.76001" end="575.96002">
