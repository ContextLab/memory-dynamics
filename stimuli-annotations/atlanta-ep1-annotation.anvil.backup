      <el index="183" start="522.96002" end="524.79999">
        <attribute name="narrative details - internal">Earn's parents are angry at him.</attribute>
        <attribute name="narrative details - external">Earns father continues to berate him for using their bathroom and not flushing the toilet. Earn shakes his head.</attribute>
        <attribute name="characters on screen">Earn</attribute>
      </el>
      <el index="184" start="524.79999" end="525.76001">
