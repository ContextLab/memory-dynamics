      </el>
      <el index="412" start="1242.47998" end="1250.43994">
        <attribute name="narrative details - external">Alfred Paper Boy and Darius are sitting and dancing in the car in the parking lot outside the convenience store. Earn walks up to the car. Paper Boy's song is playing.</attribute>
        <attribute name="characters on screen">Earn, Alfred Paper Boy, Darius</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="413" start="1250.43994" end="1253.28003">
        <attribute name="narrative details - external">Earn walks around to the passenger door of the car. Alfred Paper Boy and Darius are inside, smoking a blunt (marijuana cigar) and listening to Paper Boy</attribute>
        <attribute name="characters on screen">Darius, Alfred Paper Boy</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="414" start="1253.28003" end="1256.64001">
