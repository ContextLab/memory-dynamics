        <attribute name="narrative details - external">Alfred Paper Boy replies and jokingly tells Earn to calm down</attribute>
        <attribute name="characters on screen">Alfred Paper Boy</attribute>
        <attribute name="Music Presence">true</attribute>
      </el>
      <el index="410" start="1233.56006" end="1236.80005">
