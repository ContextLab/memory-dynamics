# builds an image for running the notebooks to reproduce analyses and figures
FROM contextlab/cdl-jupyter:3.8

LABEL maintainer="Paxton Fitzpatrick <paxton.c.fitzpatrick@dartmouth.edu>"

ARG NB_PORT=8888
ARG WORKDIR="/mnt"
ARG DEVELOP=0

ENV NOTEBOOK_PORT $NB_PORT
ENV NOTEBOOK_DIR $WORKDIR

COPY code/helpers/ /tmp/helpers/

RUN apt-get update --fix-missing \
    && apt-get install -y --no-install-recommends \
        g++ \
        git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && conda install -Sy \
        matplotlib=3.2.2 \
        mpi4py=3.0.3 \
        nltk=3.4.4 \
        num2words=0.5.10 \
        numba=0.52.0 \
        numpy=1.19.1 \
        pandas=1.1.2 \
        scikit-learn=0.23.2 \
        scipy=1.5.2 \
        seaborn=0.11.1 \
        umap-learn=0.4.6 \
        wordcloud=1.8.1 \
    && conda clean -afy \
    && pip install \
        pycircstat==0.0.2 \
        git+https://github.com/brainiak/brainiak.git@v0.11#egg=brainiak \
        git+https://github.com/ContextLab/hypertools.git@36c12fd6d1706fb75e596a62b555ee819ddada6a#egg=hypertools \
        git+https://github.com/ContextLab/quail.git@71dd53c792dd915dc84879d8237e3582dd68b7a4#egg=quail \
    && if [ "$DEVELOP" == "0" ]; then \
           pip install /tmp/helpers; \
       fi \
    && rm -rf ~/.cache/pip \
    && rm -rf /tmp/

WORKDIR $WORKDIR
